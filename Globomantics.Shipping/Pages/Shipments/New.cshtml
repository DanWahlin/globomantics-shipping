@page "/shipments/new"
@model Globomantics.Shipping.Pages.Shipments.NewModel
@{
    ViewData["Title"] = "Book a shipment";
}

<a class="back" asp-page="/Index">Back to shipments</a>

<div class="page-header">
    <h1>Book a shipment</h1>
</div>

<form method="post" class="booking" novalidate>
    <div class="booking-columns">
        <fieldset>
            <legend>Recipient</legend>

            <div class="field">
                <label asp-for="Form.RecipientName"></label>
                <input asp-for="Form.RecipientName" autocomplete="name" required>
                <span asp-validation-for="Form.RecipientName" class="field-error"></span>
            </div>

            <div class="field">
                <label asp-for="Form.Street"></label>
                <input asp-for="Form.Street" autocomplete="street-address" required>
                <span asp-validation-for="Form.Street" class="field-error"></span>
            </div>

            <div class="field-row">
                <div class="field field-short">
                    <label asp-for="Form.PostalCode"></label>
                    <input asp-for="Form.PostalCode" autocomplete="postal-code" required>
                    <span asp-validation-for="Form.PostalCode" class="field-error"></span>
                </div>
                <div class="field">
                    <label asp-for="Form.City"></label>
                    <input asp-for="Form.City" autocomplete="address-level2" required>
                    <span asp-validation-for="Form.City" class="field-error"></span>
                </div>
            </div>
        </fieldset>

        <fieldset>
            <legend>Parcel</legend>

            <div class="field field-short">
                <label asp-for="Form.WeightKg"></label>
                <input asp-for="Form.WeightKg" type="number" step="0.1" min="0.1" max="30" required>
                <span asp-validation-for="Form.WeightKg" class="field-error"></span>
            </div>

            <div class="field">
                <label asp-for="Form.Service"></label>
                <select asp-for="Form.Service" required>
                    <option value="">Choose a service</option>
                    @foreach (var provider in Model.Bookable)
                    {
                        <optgroup label="@provider.DisplayName">
                            @foreach (var service in provider.Services)
                            {
                                var value = Globomantics.Shipping.Pages.Shipments.NewModel.ServiceValue(provider, service);
                                <option value="@value">
                                    @service.Name (@Formatting.TransitTime(service.TransitDays))
                                </option>
                            }
                        </optgroup>
                    }
                </select>
                <span asp-validation-for="Form.Service" class="field-error"></span>
                @foreach (var provider in Model.NotBookable)
                {
                    <p class="hint">@provider.DisplayName can't be booked yet because none of its services are set up in Globomantics Shipping.</p>
                }
            </div>
        </fieldset>
    </div>

    <div class="actions">
        <button type="submit" class="button button-primary">Book shipment</button>
        <a class="button" asp-page="/Index">Cancel</a>
    </div>
</form>
