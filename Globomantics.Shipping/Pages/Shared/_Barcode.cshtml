@model string
@{
    // Decorative only: draws a barcode-like pattern from the reference so each label looks unique.
    var x = 0;
    var bars = new List<(int X, int Width)>();
    foreach (var c in Model)
    {
        for (var bit = 0; bit < 6; bit++)
        {
            var width = ((c >> bit) & 1) == 1 ? 3 : 1;
            bars.Add((x, width));
            x += width + 2;
        }
    }
}
<svg class="barcode" viewBox="0 0 @x 40" preserveAspectRatio="none" aria-hidden="true">
    @foreach (var (barX, width) in bars)
    {
        <rect x="@barX" width="@width" height="40" />
    }
</svg>
